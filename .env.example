# Copy to .env if you need to override defaults. Values below match docker-compose.yml.
# Owner connection used by Alembic (SQLAlchemy URL).
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/agencydesk
# Used by tests (libpq conninfo). Tests create and drop ad_test themselves.
DATABASE_URL=host=localhost port=5433 user=postgres password=postgres dbname=ad_test
ADMIN_DATABASE_URL=host=localhost port=5433 user=postgres password=postgres dbname=postgres
