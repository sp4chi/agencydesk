# Template for .env (create it with `make env`). Values below match docker-compose.yml.
# No real secrets here: the DB passwords are local-Docker dev defaults.
# Owner connection used by Alembic (SQLAlchemy URL).
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/agencydesk
# Used by tests (libpq conninfo). Tests create and drop ad_test themselves.
DATABASE_URL=host=localhost port=5433 user=postgres password=postgres dbname=ad_test
ADMIN_DATABASE_URL=host=localhost port=5433 user=postgres password=postgres dbname=postgres
# API request pool. Logs in as agencydesk_api (RLS applies). Password from db/dev_roles.sql (dev only).
API_DATABASE_URL=postgresql+psycopg://agencydesk_api:dev-api-password@localhost:5433/agencydesk
# Signs session tokens. The app refuses to start while this is missing or "change-me".
# `make env` copies this file to .env and fills in a random value.
SESSION_SECRET=change-me
